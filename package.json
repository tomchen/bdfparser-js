{
  "name": "bdfparser",
  "version": "3.0.0",
  "description": "BDF / PCF bitmap font parser, editor and converter (BDF, PCF, pixel TTF with square or round dots) in TypeScript / JavaScript, for Node.js, Deno, Bun and browsers",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/bdfparser.global.js",
  "jsdelivr": "./dist/bdfparser.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cjk": {
      "import": {
        "types": "./dist/cjk.d.ts",
        "default": "./dist/cjk.js"
      },
      "require": {
        "types": "./dist/cjk.d.cts",
        "default": "./dist/cjk.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bdfparser": "./dist/cli.js"
  },
  "sideEffects": [
    "./dist/cjk.js",
    "./dist/cjk.cjs",
    "./dist/bdfparser.global.js",
    "./dist/bdfparser-cjk.global.js",
    "./src/cjk.ts"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "gen:charsets": "cd ../bdfparser && uv run python ../bdfparser-js/tools/gen_charsets.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "parity": "python3 tools/parity/run_all.py",
    "package": "bun run build && npm pack",
    "addscope": "node tools/packagejson.cjs name @tomchen/bdfparser"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bdf",
    "pcf",
    "ttf",
    "bitmap",
    "font",
    "pixel",
    "parser",
    "editor",
    "converter",
    "node",
    "deno",
    "bun",
    "browser"
  ],
  "author": "Tom Chen <tomchen.org@gmail.com>",
  "license": "MIT",
  "homepage": "https://font.tomchen.org/bdfparser_js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomchen/bdfparser-js.git"
  },
  "bugs": {
    "url": "https://github.com/tomchen/bdfparser-js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10",
    "eslint-config-prettier": "10",
    "fetchline": "1",
    "globals": "^17.13.0",
    "husky": "9",
    "iconv-lite": "0.7",
    "opentype.js": "2",
    "prettier": "3",
    "readlineiter": "1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8",
    "vitest": "5.0.3"
  }
}
